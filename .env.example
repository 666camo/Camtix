# Database settings
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
JPA_DDL_AUTO=update

# JWT Configuration (generate strong 256-bit / 64-char key in production)
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_long_for_hs256_algorithm
JWT_EXPIRATION=86400000

# Gmail SMTP Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# MinIO / Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=camtix-images

# Internal Shared API Key between Services
INTERNAL_API_KEY=your_internal_api_key_secret

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
